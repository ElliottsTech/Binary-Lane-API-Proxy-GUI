# ──────────────────────────────────────────────────────────────────────────
# bl-api-proxy-admin — environment configuration
# Copy this file to .env and fill in all values.
# ──────────────────────────────────────────────────────────────────────────

# Session + bootstrap secrets. Generate with:  openssl rand -hex 32
SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

# APISIX admin key + master BinaryLane API token, copied from the proxy
# project's .env (the one created when you set up the APISIX proxy).
# The master token is injected into the route's proxy-rewrite header on
# redeploy; it is never sent to the browser.
ADMIN_KEY=
BL_API_TOKEN=

# WebAuthn relying-party config.
#   RP_ID  = the domain your reverse proxy serves (no scheme, no path)
#   ORIGIN = the full HTTPS URL
# WebAuthn REQUIRES a secure context (HTTPS), so a reverse proxy with TLS
# is mandatory. localhost also counts as secure for local development.
RP_ID=bl-api.example.com
ORIGIN=https://bl-api.example.com

# APISIX admin API base URL, reachable from inside the container.
# Default works when this container joins the proxy's docker network
# (see docker-compose.yml `networks:` and APISIX_NETWORK below).
APISIX_ADMIN_URL=http://bl-apisix:9180/apisix/admin

# Paths to the proxy project's roles.json + Lua policy generator.
# These are mounted read-only into the container at /bl-proxy (see
# docker-compose.yml volumes). Keep these as the in-container paths.
ROLES_JSON=/bl-proxy/manifest/roles.json
POLICY_GENERATOR=/bl-proxy/scripts/generate-policy-lua.py

# ── docker-compose variable substitution (optional overrides) ──────────────
# Host path to the proxy project (for the read-only volume mounts).
PROXY_DIR=../bl-api-proxy
# Name of the external docker network the APISIX proxy lives on.
APISIX_NETWORK=bl-api-proxy_apisix-net
