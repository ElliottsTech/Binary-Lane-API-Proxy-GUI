{
  "name": "bl-api-proxy-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Passkey-secured admin GUI for the BinaryLane JWT-scoped API proxy (APISIX user/permission management)",
  "license": "MIT",
  "homepage": "https://github.com/ElliottsTech/Binary-Lane-API-Proxy-GUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElliottsTech/Binary-Lane-API-Proxy-GUI.git"
  },
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^11.0.0",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "iron-session": "^8.0.4"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^11.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "vite": "^5.4.11"
  }
}
